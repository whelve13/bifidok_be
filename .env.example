# Google AI Studio Gemini API Key
# Replace with your actual Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional Database URL (defaults to SQLite sales_intelligence.db if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/sales_intelligence
